{
  "name": "byjg/redis-queue-client",
  "description": "A simple and efficient abstraction layer for publishing and consuming messages from Redis queues using the byjg/message-queue-client framework",
  "autoload": {
    "psr-4": {
      "ByJG\\MessageQueueClient\\RedisQueue\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": ">=8.3 <8.7",
    "ext-curl": "*",
    "ext-redis": "*",
    "byjg/message-queue-client": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "psalm/phar": "^6.16"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": "vendor/bin/psalm.phar"
  },
  "license": "MIT"
}
